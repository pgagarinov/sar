# Target locations for the repos (relative to this workspace)
SUPERVISOR_REPO=../sar-supervisor
RESEARCH_LOOP_REPO=../sar-research-loop
RAG_TARGET_REPO=../sar-rag-target
HARNESS_CORE_REPO=../sar-harness-core

# GitHub org/user
GITHUB_OWNER=pgagarinov

# GitHub repo names
SUPERVISOR_REPO_NAME=sar-supervisor
RESEARCH_LOOP_REPO_NAME=sar-research-loop
RAG_TARGET_REPO_NAME=sar-rag-target
HARNESS_CORE_REPO_NAME=sar-harness-core

# Claude config directories (colon-separated, like PATH)
# Used by all repos that launch Claude sessions (supervisor, integration hub)
# The /setup-env skill auto-detects these from ~/.claude-*
CLAUDE_CONFIG_DIRS=~/.claude-profile1:~/.claude-profile2
